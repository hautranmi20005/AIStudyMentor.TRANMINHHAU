# Copy to backend/.env.prod locally or configure equivalent protected deployment secrets.
# Generate unique high-entropy values; never commit the real file.
POSTGRES_DB=ai_study_mentor
POSTGRES_USER=studymentor_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_SSL_ENABLED=false
SPRING_DATA_REDIS_PORT=6379
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ai_study_mentor

# Optional browser clients; exact origins only, comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_PORT=8080

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-key
GEMINI_API_KEY=replace-with-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
APP_BASE_URL=https://api.example.com
RATE_LIMIT_ENABLED=true
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_USERNAME=monitoring
MANAGEMENT_PASSWORD=replace-with-a-random-secret-at-least-24-characters
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
SENDGRID_API_KEY=replace-with-sendgrid-api-key
MAIL_FROM=verified-sender@example.com
