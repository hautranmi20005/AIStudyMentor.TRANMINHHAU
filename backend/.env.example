# ==============================================================================
# AI Study Mentor Backend - Environment Variables Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Database Configuration (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/ai_study_mentor?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASS=password

# Redis Configuration (Cache layer)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days
JWT_MFA_SESSION_EXPIRATION_MS=300000   # 5 minutes

# Google Gemini API (Backend Only - NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_VERSION=v1beta
