# Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_study_mentor?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=studymentor_app
DB_PASSWORD=studymentor_dev_password

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# JWT Security
JWT_SECRET=dev_only_jwt_secret_must_be_at_least_32_bytes_long_123456
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_MFA_SESSION_EXPIRATION_MS=300000

# Security Encryption
MFA_ENCRYPTION_KEY=dev_aes_key_32_bytes_length_123456

# Google Gemini API
GEMINI_API_KEY=<SET_ME>
GEMINI_MODEL=<SET_ME>
GEMINI_API_VERSION=<SET_ME>

# Mailpit SMTP Configuration
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# Application Base URL
APP_BASE_URL=http://127.0.0.1:8080
