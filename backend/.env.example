# Single environment template for local development and production.
# Local setup: run scripts/gen-secrets.ps1 (Windows) or scripts/gen-secrets.sh
# (Unix) to create backend/.env with fresh secrets. Keep the generated file private.
# For manual setup, copy this file to backend/.env and replace every secret placeholder.
# Use plain KEY=VALUE lines without quotes; Spring Boot also imports this file.

# Local MySQL and Redis
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_study_mentor?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=studymentor_app
DB_PASSWORD=__GENERATED_BY_SCRIPT__
DB_ROOT_PASSWORD=__GENERATED_BY_SCRIPT__
DEV_MYSQL_PORT=3306
DEV_REDIS_PORT=6379
DEV_MAIL_SMTP_PORT=1025
DEV_MAIL_UI_PORT=8025

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATED_BY_SCRIPT__

# Authentication and local demo seed
JWT_SECRET=__GENERATED_BY_SCRIPT__
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_MFA_SESSION_EXPIRATION_MS=300000
MFA_ENCRYPTION_KEY=__GENERATED_BY_SCRIPT__
DEV_SEED_PASSWORD=DemoPass123!
DEV_SEED_TOTP_SECRET=JBSWY3DPEHPK3PXP
MANAGEMENT_USERNAME=monitoring
MANAGEMENT_PASSWORD=__GENERATED_BY_SCRIPT__

# Google Gemini API
# Optional for backend startup; Ask AI requires a real key.
GEMINI_API_KEY=<SET_ME>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_VERSION=v1beta
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
AI_PROVIDER=gemini

# Local Mailpit SMTP
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost

# Local application URLs
APP_BASE_URL=http://localhost:8080
GUARDIAN_CONSENT_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_PREFIX=studymentor:rate-limit
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_MFA_LIMIT=5
RATE_LIMIT_MFA_WINDOW_SECONDS=900
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
MANAGEMENT_SERVER_PORT=8081
GUARDIAN_CONSENT_REMINDER_SCAN_DELAY_MS=3600000

# Production-only settings. When creating backend/.env.prod, uncomment and
# replace these values. Also replace the local DB, Redis, URL, mail, Gemini,
# JWT, MFA, and management settings above with production values.
# POSTGRES_DB=ai_study_mentor
# POSTGRES_USER=studymentor_app
# POSTGRES_PASSWORD=replace-with-a-long-random-secret
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ai_study_mentor
# SPRING_DATA_REDIS_USERNAME=default
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_SSL_ENABLED=false
# APP_PORT=8080
# MAIL_USERNAME=apikey
# SENDGRID_API_KEY=replace-with-provider-key
# MAIL_CONNECTION_TIMEOUT_MS=5000
# MAIL_TIMEOUT_MS=5000
# MAIL_WRITE_TIMEOUT_MS=5000
